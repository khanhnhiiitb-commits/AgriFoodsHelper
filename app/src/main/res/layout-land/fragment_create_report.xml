<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo bài đăng giải cứu"
            android:textColor="#2E7D32"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hãy cung cấp thông tin nông sản cần giải cứu."
            android:textColor="#666666"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên nông sản *"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtProductName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Ví dụ: Xoài cát"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hình ảnh nông sản *"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgProductPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#E8F5E9"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh nông sản"
            app:tint="#2E7D32" />

        <Button
            android:id="@+id/btnChooseImage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#E8F5E9"
            android:text="CHỌN ẢNH TỪ ĐIỆN THOẠI"
            android:textColor="#2E7D32"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sản lượng cần giải cứu (kg) *"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:hint="Ví dụ: 100"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ nông sản *"
            android:textColor="#333333"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAddress"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="top"
            android:hint="Nhập xã/phường, huyện/quận, tỉnh/thành phố"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCreateReport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#2E7D32"
            android:text="ĐĂNG BÀI GIẢI CỨU"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
