<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Thẻ phân loại & Khẩn cấp -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvJobTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▬ Xe tải"
                android:textColor="#009688"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJobUrgentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="• Khẩn cấp"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </RelativeLayout>

        <!-- Thông tin chính: Ảnh, Tên chiến dịch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgJobThumbnail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="#E8F5E9"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvJobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tên chiến dịch"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJobProgressSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tiến độ giải cứu nông sản"
                    android:textColor="#9E9E9E"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="#9E9E9E" />
        </LinearLayout>

        <!-- Chi tiết Địa điểm & Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Điểm bốc hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#9E9E9E" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điểm bốc hàng"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvJobPickup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có thông tin"
                        android:textColor="#424242"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Điểm giao hàng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#9E9E9E" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Điểm giao hàng"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvJobDropoff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có thông tin"
                        android:textColor="#424242"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thời gian huy động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#9E9E9E" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian huy động"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvJobTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chưa có thông tin"
                        android:textColor="#424242"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Đường kẻ ngang -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#EEEEEE" />

        <!-- Tải trọng & Tiến độ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Dòng 1: Tải trọng -->
            <TextView
                android:id="@+id/lblWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tải trọng cần thiết"
                android:textColor="#424242"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvJobRequiredWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Chưa xác định"
                android:textColor="#009688"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Dòng 2: Số xe -->
            <TextView
                android:id="@+id/lblTrucks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/lblWeight"
                android:layout_marginTop="8dp"
                android:text="Số xe cần huy động"
                android:textColor="#424242"
                android:textSize="13sp" />

            <!-- Dòng 3: Số xe đã nhận -->
            <TextView
                android:id="@+id/tvJobReceivedTrucks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/lblTrucks"
                android:layout_marginTop="2dp"
                android:text="Đã nhận 0 xe"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <!-- Trạng thái chờ -->
            <TextView
                android:id="@+id/tvJobStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@id/tvJobReceivedTrucks"
                android:layout_alignParentEnd="true"
                android:text="Đang chờ tài xế"
                android:textColor="#009688"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Thanh ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBarJobTrucks"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:progressDrawable="@android:drawable/progress_horizontal" />

        <!-- Nút Nhận Chuyến -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptJob"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#19B97C"
            android:text="Nhận chuyến"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>