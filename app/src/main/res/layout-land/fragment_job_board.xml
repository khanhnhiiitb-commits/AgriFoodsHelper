<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8F6">

    <!-- PHAN NOI DUNG CO THE CUON -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- LOGO VA TEN UNG DUNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textSize="23sp"
                    android:textColor="#0CAF79" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giải cứu Nông sản"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#15966A" />

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textSize="18sp"
                    android:textColor="#596B60"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <!-- TIEU DE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bảng tin Điều phối"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#26382E"
                android:layout_marginTop="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Góp một chuyến xe, thêm một bàn tay."
                android:textSize="12sp"
                android:textColor="#89958D"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp" />

            <!-- THONG BAO CHUYEN XE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="#E5F9F0"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="♧"
                    android:textSize="20sp"
                    android:textColor="#0CAF79"
                    android:background="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2 lệnh đang cần bạn"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#187C5A" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Từ 2 chuyến đang cần thêm người"
                        android:textSize="10sp"
                        android:textColor="#57967C" />
                </LinearLayout>
            </LinearLayout>

            <!-- O TIM KIEM -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="⌕  Tìm chuyến dịch, địa điểm..."
                android:textSize="12sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="8dp" />

            <!-- CAC BO LOC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#10B981" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Xe tải"
                    android:textSize="11sp"
                    android:textColor="#52645A"
                    android:background="#FFFFFF"
                    android:layout_marginStart="5dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:text="Tình nguyện viên"
                    android:textSize="10sp"
                    android:textColor="#52645A"
                    android:background="#FFFFFF"
                    android:layout_marginStart="5dp" />
            </LinearLayout>

            <!-- TIEU DE DANH SACH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lệnh đang mở (2)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#293A30" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↕ Ưu tiên khẩn"
                    android:textSize="10sp"
                    android:textColor="#7E8C83" />
            </LinearLayout>

            <!-- THE XE TAI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="10dp">

                <!-- Loai lenh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="▰ Xe tải"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#168F69" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Khẩn cấp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#E05252" />
                </LinearLayout>

                <!-- Anh va thong tin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:scaleType="centerCrop"
                        android:background="#E5F3E8"
                        android:contentDescription="Ảnh nông sản" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thanh Long Ruột Đỏ Bình Thuận"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#293A30" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đã giải cứu 350/500 kg"
                            android:textSize="10sp"
                            android:textColor="#89958D"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="23sp"
                        android:textColor="#7D8A81"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Dia diem -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⌖  Bình Thuận → TP. Hồ Chí Minh"
                    android:textSize="10sp"
                    android:textColor="#5F6C63"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="◷  Hôm nay · Trước 16:00"
                    android:textSize="10sp"
                    android:textColor="#5F6C63"
                    android:layout_marginTop="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8EEE9"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cần 1 xe - Tải trọng từ 500 kg"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#39483E" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đã đăng ký: 0/1 xe"
                    android:textSize="10sp"
                    android:textColor="#89958D"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="7dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="♧  Nhận chuyến"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#10B981" />
            </LinearLayout>

            <!-- THE TINH NGUYEN VIEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="♧ Tình nguyện viên"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#168F69" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Ưu tiên"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#C18B28" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:scaleType="centerCrop"
                        android:background="#E5F3E8"
                        android:contentDescription="Ảnh nông sản" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Buổi Nấm Roi Vĩnh Long qua mạng"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#293A30" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đã giải cứu 800/1.000 kg"
                            android:textSize="10sp"
                            android:textColor="#89958D"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="23sp"
                        android:textColor="#7D8A81"
                        android:gravity="center" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⌖  Bình Minh, Vĩnh Long"
                    android:textSize="10sp"
                    android:textColor="#5F6C63"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="◷  Ngày mai · 07:00 - 11:00"
                    android:textSize="10sp"
                    android:textColor="#5F6C63"
                    android:layout_marginTop="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8EEE9"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cần 10 người - Phân loại, đóng gói"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#39483E" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đã đăng ký: 6/10 người"
                    android:textSize="10sp"
                    android:textColor="#89958D"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="7dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="♧  Đăng ký hỗ trợ"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#10B981" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- THANH DIEU HUONG DUOI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="21sp"
                android:textColor="#849188" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trang chủ"
                android:textSize="9sp"
                android:textColor="#849188" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E5F9F0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▰"
                android:textSize="20sp"
                android:textColor="#10A878" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điều phối"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#10A878" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="24sp"
                android:textColor="#849188" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng bài"
                android:textSize="9sp"
                android:textColor="#849188" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▢"
                android:textSize="20sp"
                android:textColor="#849188" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn hàng"
                android:textSize="9sp"
                android:textColor="#849188" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♙"
                android:textSize="20sp"
                android:textColor="#849188" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textSize="9sp"
                android:textColor="#849188" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
