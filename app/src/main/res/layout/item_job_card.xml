
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <!-- LOAI CHUYEN VA TRANG THAI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▰ Xe tải"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#15966A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Khẩn cấp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#E65B5B" />
    </LinearLayout>

    <!-- ANH NONG SAN VA TEN CHUYEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop"
            android:background="#E5F3E8"
            android:contentDescription="Ảnh nông sản" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/txtCampaignName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên chiến dịch"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#293A30" />

            <TextView
                android:id="@+id/txtCampaignProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tiến độ giải cứu nông sản"
                android:textSize="9sp"
                android:textColor="#89958D" />
        </LinearLayout>

        <TextView
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="›"
            android:textSize="22sp"
            android:textColor="#849188" />
    </LinearLayout>

    <!-- DIEM BOC HANG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="⌖"
            android:textSize="15sp"
            android:textColor="#8499B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Điểm bốc hàng"
                android:textSize="9sp"
                android:textColor="#849188" />

            <TextView
                android:id="@+id/txtPickupLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có thông tin"
                android:textSize="10sp"
                android:textColor="#39483E" />
        </LinearLayout>
    </LinearLayout>

    <!-- DIEM GIAO HANG -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="⌖"
            android:textSize="15sp"
            android:textColor="#8499B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Điểm giao hàng"
                android:textSize="9sp"
                android:textColor="#849188" />

            <TextView
                android:id="@+id/txtDeliveryLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có thông tin"
                android:textSize="10sp"
                android:textColor="#39483E" />
        </LinearLayout>
    </LinearLayout>

    <!-- THOI GIAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="◷"
            android:textSize="15sp"
            android:textColor="#8499B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thời gian huy động"
                android:textSize="9sp"
                android:textColor="#849188" />

            <TextView
                android:id="@+id/txtMobilizationTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa có thông tin"
                android:textSize="10sp"
                android:textColor="#39483E" />
        </LinearLayout>
    </LinearLayout>

    <!-- DUONG PHAN CACH -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="8dp"
        android:background="#E8EEE9" />

    <!-- TAI TRONG CAN THIET -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tải trọng cần thiết"
            android:textSize="10sp"
            android:textColor="#39483E" />

        <TextView
            android:id="@+id/txtRequiredLoad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa xác định"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#15966A" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtRequiredTrucks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Số xe cần huy động"
        android:textSize="10sp"
        android:textColor="#39483E" />

    <!-- SO LUONG DANG KY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/txtAcceptedTrucks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đã nhận 0 xe"
            android:textSize="9sp"
            android:textColor="#89958D" />

        <TextView
            android:id="@+id/txtRemainingTrucks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang chờ tài xế"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#15966A" />
    </LinearLayout>

    <!-- THANH TIEN DO -->
    <ProgressBar
        android:id="@+id/progressJob"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressTint="#10B981" />

    <!-- NUT NHAN CHUYEN -->
    <TextView
        android:id="@+id/btnAcceptJob"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="▣  Nhận chuyến"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#10B981"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
