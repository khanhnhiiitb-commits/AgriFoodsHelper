<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="38dp"
        android:paddingBottom="20dp">

        <!-- LOGO -->
        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="♧"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:background="#4CAF50" />

        <!-- TEN UNG DUNG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="AgriFoodsHelper"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#31883D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Ứng dụng hỗ trợ giải cứu nông sản"
            android:textSize="12sp"
            android:textColor="#65A96B" />

        <!-- EMAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Email"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#37483A" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:hint="Nhập email của bạn"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#C9D8BF" />

        <!-- MAT KHAU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Mật khẩu"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#37483A" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:hint="Nhập mật khẩu"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#C9D8BF" />

        <!-- QUEN MAT KHAU -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="Quên mật khẩu?"
            android:textSize="11sp"
            android:textColor="#4CAF50" />

        <!-- NUT DANG NHAP -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Đăng nhập"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#4CAF50" />

        <!-- DUONG PHAN CACH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D6DFD0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="hoặc"
                android:textSize="11sp"
                android:textColor="#8B9888" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D6DFD0" />
        </LinearLayout>

        <!-- DANG NHAP GOOGLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#F5F6F0"
            android:layout_marginTop="6dp"
            android:padding="8dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="G"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4285F4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Đăng nhập bằng Google"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#388E3C" />
        </LinearLayout>

        <!-- DANG KY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản? "
                android:textSize="11sp"
                android:textColor="#8B9888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4CAF50" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
