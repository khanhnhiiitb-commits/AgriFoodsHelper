<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tiêu đề chính -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tạo bài đăng giải cứu"
            android:textColor="#2E7D32"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hãy cung cấp thông tin nông sản cần giải cứu."
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- 1. Tên nông sản -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tên nông sản *"
            android:textColor="#212121"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCampaignTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#9E9E9E"
            android:hint="Ví dụ: Xoài cát"
            android:inputType="text"
            android:textSize="15sp" />

        <!-- 2. Hình ảnh nông sản -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Hình ảnh nông sản *"
            android:textColor="#212121"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgCampaignPhoto"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:background="#E8F5E9"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="#A5D6A7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E8F5E9"
            android:text="CHỌN ẢNH TỪ ĐIỆN THOẠI"
            android:textColor="#2E7D32"
            app:cornerRadius="8dp"
            app:elevation="0dp" />

        <!-- 3. Sản lượng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sản lượng cần giải cứu (kg) *"
            android:textColor="#212121"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCampaignQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#9E9E9E"
            android:hint="Ví dụ: 100"
            android:inputType="numberDecimal"
            android:textSize="15sp" />

        <!-- 4. Địa chỉ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Địa chỉ nông sản *"
            android:textColor="#212121"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtCampaignAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#9E9E9E"
            android:hint="Nhập xã/phường, huyện/quận, tỉnh/thành phố"
            android:inputType="textPostalAddress"
            android:textSize="15sp" />

        <!-- Nút Submit -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitCampaign"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2E7D32"
            android:text="Gửi yêu cầu giải cứu"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>